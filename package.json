{
  "name": "rekoto",
  "productName": "Rekoto",
  "version": "1.0.0",
  "description": "Local screen and camera recorder with branded backgrounds, clean desktop mode and browser privacy extensions.",
  "author": "Khotso Tsoaela",
  "license": "MIT",
  "homepage": "https://ktsoaela.github.io/rekoto/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktsoaela/rekoto.git"
  },
  "bugs": {
    "url": "https://github.com/ktsoaela/rekoto/issues"
  },
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "kill": "node scripts/kill.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:ext": "node scripts/build-extensions.mjs",
    "dist": "npm run icons && npm run build:ext && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
